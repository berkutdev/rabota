#include <iostream>

using namespace std;

class ArraySorter {
private:
    int* arr;
    int size;

public:
    ArraySorter(int* sourceArr, int n) {
        size = n;
        arr = new int[size];
        for (int i = 0; i < size; i++) {
            arr[i] = sourceArr[i];
        }
    }

    ~ArraySorter() {
        delete[] arr;
    }

    void print() const {
        for (int i = 0; i < size; i++) {
            cout << arr[i] << " ";
        }
        cout << endl;
    }

    
    int bubbleSort() {
        int iterations = 0;

        for (int i = 0; i < size - 1; i++) {
            bool swapped = false;

            for (int j = 0; j < size - 1 - i; j++) {
                iterations++;
                if (arr[j] > arr[j + 1]) {
                    int temp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = temp;
                    swapped = true;
                }
            }

            if (!swapped) {
                break;
            }
        }

        return iterations;
    }

    
    int insertionSort() {
        int iterations = 0;

        for (int i = 1; i < size; i++) {
            int key = arr[i];
            int j = i - 1;

            
            while (j >= 0 && arr[j] > key) {
                iterations++;
                arr[j + 1] = arr[j];
                j--;
            }

           
            if (j >= 0) {
                iterations++;
            }

            arr[j + 1] = key;
        }

        return iterations;
    }
};
