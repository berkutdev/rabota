#include <iostream>

class Date {
private:
    int day;
    int month;
    int year;

public:
    
    Date(int d, int m, int y) {
        day = d;
        month = m;
        year = y;
    }

    
    void print() {
       cout << day << "." << month << "." << year << std::endl;
    }

    
  
    int operator-(const Date& other) {
        return this->day - other.day;
    }

    Date operator+(int daysToAdd) {
        return Date(this->day + daysToAdd, this->month, this->year);
    }
};

int main() {
    
    Date d1(10, 5, 2026);
    Date d2(25, 5, 2026);

   cout << "data 1: ";
    d1.print();

    cout << "data 2: ";
    d2.print();

    
    int diff = d2 - d1;
    std::cout << "raznost d днях: " << diff << std::endl;

    Date d3 = d1 + 5;
    std::cout << " data 1+5: ";
    d3.print();

    return 0;
}
