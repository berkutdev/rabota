#include <iostream>
#include <string>
using namespace std;

class Student
{
private:
    string name;
    string group;
    string speciality;

    const int ID;
    const string adress;

public:
   
    Student() : ID(0), adress("")
    {
        name = "";
        group = "";
        speciality = "";
    }

    
    Student(string n, string g, string s, int id, string a)
        : ID(id), adress(a)
    {
        name = n;
        group = g;
        speciality = s;
    }


    string getName()
    {
        return name;
    }

    string getGroup()
    {
        return group;
    }

    string getSpeciality()
    {
        return speciality;
    }

    int getID()
    {
        return ID;
    }

    string getAdress()
    {
        return adress;
    }


    void setName(string n)
    {
        name = n;
    }

    void setGroup(string g)
    {
        group = g;
    }

    void setSpeciality(string s)
    {
        speciality = s;
    }

    
    void printStudent()
    {
        cout << "Name: " << name << endl;
        cout << "Group: " << group << endl;
        cout << "Speciality: " << speciality << endl;
        cout << "ID: " << ID << endl;
        cout << "Adress: " << adress << endl;
    }

    
    void changeGroup(string newGroup)
    {
        group = newGroup;
    }
};

int main()
{
    Student student1;

    Student student2(
        "",
        "",
        "",
        ,
        ""
    );

    cout << "Student 1:" << endl;
    student1.printStudent();

    cout << endl;

    cout << "Student 2:" << endl;
    student2.printStudent();

    cout << endl;

    student2.changeGroup("IT-102");

    cout << "After changing group:" << endl;
    student2.printStudent();

    return 0;
}
